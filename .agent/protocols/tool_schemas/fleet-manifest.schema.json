{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-stack.local/schemas/fleet-manifest.schema.json",
  "title": "agentic-stack fleet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profile", "fleetRoot", "workspaces", "exclusions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "profile": {"type": "string", "minLength": 1},
    "fleetRoot": {"type": "string", "minLength": 1},
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "mode", "displayName", "repositories", "adapters", "rationale"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "mode": {"enum": ["managed", "source", "pending", "external"]},
          "displayName": {"type": "string", "minLength": 1},
          "repositories": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "adapters": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string"}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
